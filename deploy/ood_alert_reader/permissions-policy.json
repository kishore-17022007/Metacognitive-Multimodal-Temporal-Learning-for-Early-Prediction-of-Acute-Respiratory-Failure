{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyLiveOODAlert",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::tbi-arf-mlops-mlops-2026/monitoring/live-ood-alert.json"
    },
    {
      "Sid": "CheckOnlyLiveOODAlertKey",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::tbi-arf-mlops-mlops-2026",
      "Condition": {
        "StringEquals": {
          "s3:prefix": "monitoring/live-ood-alert.json"
        }
      }
    }
  ]
}
